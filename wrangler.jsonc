{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The workers.dev preview. No routes and no custom domain until the PL6 release.
  "name": "hikari-marketplace-preview",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/p/*", "/index.json*"]
  },
  "observability": { "enabled": true }
}
